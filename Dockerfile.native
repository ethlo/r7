# syntax=docker/dockerfile:1
# Oracle GraalVM (GFTC-licensed, https://www.oracle.com/downloads/licenses/graal-free-license.html)
# rather than the community edition - this is what makes --gc=G1 available to the native-image
# build below (G1 is not implemented in GraalVM Community Edition). Only the *tool* is Oracle-
# licensed; this builder stage is discarded and never shipped, see STAGE 2 below.
FROM container-registry.oracle.com/graalvm/native-image:25 AS builder

WORKDIR /build

# r7-journal-mmap's pom.xml invokes the repo's checked-in bin/flatc directly (not whatever is on
# PATH), and that wrapper dispatches to a per-arch binary - no separate flatc install needed here.
COPY . .

# Build everything.
RUN --mount=type=cache,target=/root/.m2 \
    ./mvnw clean install -Pnative -DskipTests -pl r7-undertow -am && \
    ./mvnw native:compile -Pnative -DskipTests -pl r7-undertow

# STAGE 2: Runtime

# distroless has no shell, so a directory can't be chown'd in this stage - prepare it in a tiny
# side stage instead. Docker copies an image's pre-existing directory (including ownership) into
# a *named* volume the first time that volume is created empty, so this is what makes a freshly
# created r7-journals volume writable by the nonroot user below instead of root:root.
FROM busybox:stable AS dirs
RUN mkdir -p /journals && chown 65532:65532 /journals

FROM gcr.io/distroless/cc-debian13
# The r7-server binary is built with -H:+StaticExecutableWithDynamicLibC (see
# r7-undertow/pom.xml), so it still dynamically links glibc - needed to keep glibc's NSS-based
# getaddrinfo working for upstream hostname resolution (a fully static/musl build breaks that).
# The Oracle GraalVM builder image is Oracle Linux 10 (glibc 2.39+); cc-debian12's glibc (2.36)
# is too old to satisfy that, so the runtime needs debian13 (glibc 2.41) or newer here.
WORKDIR /app

COPY --from=builder /build/r7-undertow/target/r7-server /app/server
COPY --from=dirs --chown=65532:65532 /journals /journals

USER 65532:65532
ENTRYPOINT ["/app/server", "-Djava.security.egd=file:/dev/./urandom"]


