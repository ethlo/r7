# Dockerfile.jvm

# distroless has no shell, so a directory can't be chown'd in the final stage - prepare it here
# instead. Docker copies an image's pre-existing directory (including ownership) into a *named*
# volume the first time that volume is created empty, so this is what makes a freshly created
# r7-journals volume writable by the nonroot user below instead of root:root.
FROM busybox:stable@sha256:73aaf090f3d85aa34ee199857f03fa3a95c8ede2ffd4cc2cdb5b94e566b11662 AS dirs
RUN mkdir -p /journals && chown 65532:65532 /journals

FROM gcr.io/distroless/java25-debian13:nonroot@sha256:ca60da1345c0f17b6d019049e6749e15f10fd3c0da86dec938d2b4ec565d0629
WORKDIR /app

# We assume the JAR is already compiled by the CI runner
COPY r7-undertow/target/r7-undertow-*.jar /app/server.jar
COPY --from=dirs --chown=65532:65532 /journals /journals

USER 65532:65532
# The management endpoint binds to loopback by default; inside a container that would make the
# published status port unreachable, so listen on all interfaces and let the port mapping decide
# who can reach it - publish it on loopback (127.0.0.1:19999:18888), not on every host interface.
# Set management.host in server.yaml to override.
ENV R7_MANAGEMENT_HOST=0.0.0.0
ENTRYPOINT ["java", "-Djava.security.egd=file:/dev/./urandom", "-jar", "/app/server.jar"]