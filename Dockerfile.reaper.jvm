# Dockerfile.reaper.jvm

# distroless has no shell, so a directory can't be chown'd in the final stage - prepare it here
# instead. Docker copies an image's pre-existing directory (including ownership) into a *named*
# volume the first time that volume is created empty, so this is what makes a freshly created
# r7-journals volume writable by the nonroot user below instead of root:root. Bind-mounted host
# directories are not affected by this - their ownership is the operator's responsibility.
FROM busybox:stable@sha256:73aaf090f3d85aa34ee199857f03fa3a95c8ede2ffd4cc2cdb5b94e566b11662 AS dirs
RUN mkdir -p /journals && chown 65532:65532 /journals

FROM gcr.io/distroless/java25-debian13:nonroot@sha256:ca60da1345c0f17b6d019049e6749e15f10fd3c0da86dec938d2b4ec565d0629
WORKDIR /app

# Copy the reaper fat JAR
COPY r7-reaper/target/r7-reaper-*.jar /app/reaper.jar
COPY --from=dirs --chown=65532:65532 /journals /journals

# Unlike every tailer image, this one needs read-write access to the shared journal volume -
# it is the one process in this deployment whose job is to delete from it.
VOLUME ["/journals"]

# JOURNAL_DIR: where the gateway's binary journals live (the shared volume above). Mount this
#              read-write here - every tailer sharing the same volume should mount it :ro
#              instead, so this is the only container that can delete a segment.
# TTL:         how long a sealed segment is kept after it stops being written to, before this
#              reaper deletes it. This is a dumb, age-only policy with no awareness of any
#              tailer's read progress - set it well beyond the slowest tailer's realistic lag
#              (restart time included), see docs/journaling.md.
ENV JOURNAL_DIR=/journals
ENV TTL=7d

USER 65532:65532

ENTRYPOINT ["java", "-Djava.security.egd=file:/dev/./urandom", "-jar", "/app/reaper.jar"]
