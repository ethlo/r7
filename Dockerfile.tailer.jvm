# Dockerfile.tailer.jvm

# distroless has no shell, so a directory can't be chown'd in the final stage - prepare it here
# instead. Docker copies an image's pre-existing directory (including ownership) into a *named*
# volume the first time that volume is created empty, so this is what makes freshly created
# volumes writable by the nonroot user below instead of root:root. Bind-mounted host
# directories are not affected by this - their ownership is the operator's responsibility.
FROM busybox:stable@sha256:73aaf090f3d85aa34ee199857f03fa3a95c8ede2ffd4cc2cdb5b94e566b11662 AS dirs
RUN mkdir -p /journals /checkpoints /warc /json /bodies && chown 65532:65532 /journals /checkpoints /warc /json /bodies

# The Java 27 runtime: Temurin's JRE on distroless's Java base (the libraries its javaNN images
# add to the base image), which is how distroless builds those images. Distroless publishes them
# for LTS releases only, so the image is assembled here.
FROM eclipse-temurin:27-jre@sha256:8f8cfda6393f63a029dbe83ceda4c19a31d268184662e96d9641f57afdaf870b AS jre
FROM gcr.io/distroless/java-base-debian13:nonroot@sha256:4b56aef44dee352ec8321ac447db1592909c029183a41be1c41375ca8b936549 AS runtime
COPY --from=jre /opt/java/openjdk /opt/java/openjdk
ENV JAVA_HOME=/opt/java/openjdk
ENV PATH=/opt/java/openjdk/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

FROM runtime
WORKDIR /app

# Copy the tailer fat JAR
COPY r7-tailer/target/r7-tailer-*.jar /app/tailer.jar
COPY --from=dirs --chown=65532:65532 /journals /journals
COPY --from=dirs --chown=65532:65532 /checkpoints /checkpoints
COPY --from=dirs --chown=65532:65532 /warc /warc
COPY --from=dirs --chown=65532:65532 /json /json
COPY --from=dirs --chown=65532:65532 /bodies /bodies

# /journals:    the gateway's journals, the volume it shares with the gateway; mount it read-only.
# /checkpoints: the tailer's own progress, read (read-only) by the reaper.
# /warc, /json, /bodies: the default output directories, for WARC files, JSON lines written to
#               files and body files (json.bodies: files). Settings are in tailer.yaml
#               (docs/journaling.md).
VOLUME ["/journals", "/checkpoints", "/warc", "/json", "/bodies"]

USER 65532:65532

# Config files are read from the working directory; containers keep them in /app/config, the
# directory the docs mount. A named TAILER_CONFIG still wins.
WORKDIR /app/config

# Native and Unsafe memory access are granted up front so the JVM prints no warnings about them.
ENTRYPOINT ["/opt/java/openjdk/bin/java", "--enable-native-access=ALL-UNNAMED", "--sun-misc-unsafe-memory-access=allow", "-Djava.security.egd=file:/dev/./urandom", "-jar", "/app/tailer.jar"]
