<configuration>
    <!--
        Copies these levels to java.util.logging, so a server bridging JUL into SLF4J (Helidon)
        drops a disabled record in JUL rather than after the bridge has built an event for it.
    -->
    <contextListener class="ch.qos.logback.classic.jul.LevelChangePropagator">
        <resetJUL>true</resetJUL>
    </contextListener>

    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX, UTC} %highlight(%-5level) [%cyan(%thread)] %magenta(%logger{15}) - %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="ASYNC_STDOUT" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="STDOUT"/>
        <queueSize>10000</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <neverBlock>true</neverBlock>
    </appender>

    <root level="INFO">
        <appender-ref ref="ASYNC_STDOUT"/>
    </root>

    <logger name="r7" level="INFO" additivity="false">
        <appender-ref ref="STDOUT-RAW"/>
    </logger>

    <appender name="STDOUT-RAW" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%msg%n</pattern>
        </encoder>
    </appender>

    <logger name="io.undertow" level="WARN" />
    <logger name="org.xnio" level="WARN" />
    <logger name="io.helidon" level="WARN" />

    <logger name="r7.access" level="WARN"/>
</configuration>