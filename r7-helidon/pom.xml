<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.ethlo.r7</groupId>
        <artifactId>r7</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>
    <!--
        The gateway: r7 on Helidon's Níma web server, the only supported server. A thin adapter
        over r7-server-blocking (r7-server's ServerExchange), which it shares with the servlet
        host, proxying through r7-upstream. How it got here: design/history/server-spi.md, step 6.
    -->
    <artifactId>r7-helidon</artifactId>
    <packaging>jar</packaging>
    <name>r7-helidon</name>
    <url>https://github.com/ethlo/r7</url>
    <properties>
        <!-- Helidon pairs its releases with Java's: 4.5.x is the LTS line for Java 25, 27 is for
             Java 27 only, and 29 will be the LTS for Java 29. The default is the LTS pairing, so
             r7-helidon runs on the same Java as the rest of r7; -Phelidon-27 builds the Java 27
             line, which is the only one with per-carrier I/O pollers (design/history/upstream-client.md). -->
        <helidon.version>4.5.5</helidon.version>
    </properties>
    <build>
        <plugins>
            <plugin>
                <groupId>io.github.git-commit-id</groupId>
                <artifactId>git-commit-id-maven-plugin</artifactId>
                <version>10.0.1</version>
                <executions>
                    <execution>
                        <id>get-the-git-infos</id>
                        <goals>
                            <goal>revision</goal>
                        </goals>
                        <phase>initialize</phase>
                    </execution>
                </executions>
                <configuration>
                    <generateGitPropertiesFile>true</generateGitPropertiesFile>
                    <generateGitPropertiesFilename>${project.build.outputDirectory}/git.properties
                    </generateGitPropertiesFilename>
                    <includeOnlyProperties>
                        <includeOnlyProperty>^git.build.version$</includeOnlyProperty>
                        <includeOnlyProperty>^git.commit.id.abbrev$</includeOnlyProperty>
                    </includeOnlyProperties>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.5.1</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>com.ethlo.r7.helidon.R7Helidon</mainClass>
                            <addClasspath>true</addClasspath>
                            <classpathPrefix>lib/</classpathPrefix>
                        </manifest>
                        <manifestEntries>
                            <!--
                                The journal populates pages ahead of its writer through FFM
                                (madvise); this grants that to java -jar without a command-line
                                flag. The container image also passes the flag on its entrypoint.
                            -->
                            <Enable-Native-Access>ALL-UNNAMED</Enable-Native-Access>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
            <!--
                A plain jar with its dependencies in lib/ beside it, not one jar nesting the others:
                the JVM's AOT cache (Dockerfile.jvm) can only hold classes from the plain class
                path, and reading nested jars costs startup time of its own. java -jar still
                works, with lib/ next to the jar.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.9.0</version>
                <executions>
                    <execution>
                        <id>copy-runtime-dependencies</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <includeScope>runtime</includeScope>
                            <outputDirectory>${project.build.directory}/lib</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <profile>
            <id>helidon-27</id>
            <properties>
                <helidon.version>27.0.0</helidon.version>
                <maven.compiler.release>27</maven.compiler.release>
            </properties>
        </profile>
    </profiles>
    <dependencies>
        <dependency>
            <groupId>com.ethlo.r7</groupId>
            <artifactId>r7-server-blocking</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>io.helidon.webserver</groupId>
            <artifactId>helidon-webserver</artifactId>
            <version>${helidon.version}</version>
        </dependency>
        <dependency>
            <groupId>io.helidon.webserver</groupId>
            <artifactId>helidon-webserver-http2</artifactId>
            <version>${helidon.version}</version>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <version>${logback.version}</version>
        </dependency>
        <!--
            Helidon logs through System.Logger, which ends in java.util.logging: the JDK finds a
            System.LoggerFinder only on the system class path, and the repackaged jar's nested jars
            are not on it. R7Helidon bridges JUL into SLF4J, so Helidon's lines follow the same
            logback configuration as r7's. helidon-logging-slf4j tells Helidon's own LogConfig
            that logging is handled.
        -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>jul-to-slf4j</artifactId>
            <version>2.0.19</version>
        </dependency>
        <dependency>
            <groupId>io.helidon.logging</groupId>
            <artifactId>helidon-logging-slf4j</artifactId>
            <version>${helidon.version}</version>
        </dependency>

        <!-- TEST -->
        <dependency>
            <groupId>com.ethlo.r7</groupId>
            <artifactId>r7-server</artifactId>
            <version>1.0-SNAPSHOT</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <version>2.0.5</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>1.21.4</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-params</artifactId>
            <version>6.1.3</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.wiremock</groupId>
            <artifactId>wiremock</artifactId>
            <version>3.13.2</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <version>6.0.1</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>3.27.7</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>6.1.3</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
