namespace com.ethlo.r7.r7f.fbs;

enum FbsJournalLevel : byte { NONE = 0, METADATA = 1, HEADERS = 2, FULL = 3 }

enum IpSource : byte {
    UNKNOWN = 0,
    SOCKET = 1,
    X_FORWARDED_FOR = 2,
    X_REAL_IP = 3
}

table Header {
  name: [ubyte];
  value: [ubyte];
}

table ClientRequest {
  journal_level: FbsJournalLevel;
  req_id: [ubyte];
  start_line: [ubyte];
  headers: [Header];
  client_ip: [ubyte];
  client_ip_source: IpSource;
}

table UpstreamRequest {
  journal_level: FbsJournalLevel;
  req_id: [ubyte];
  start_line: [ubyte];
  headers: [Header];
}

table UpstreamResponse {
  journal_level: FbsJournalLevel;
  req_id: [ubyte];
  start_line: [ubyte];
  headers: [Header];
  status: uint16;
}

table ClientResponse {
  journal_level: FbsJournalLevel;
  req_id: [ubyte];
  start_line: [ubyte];
  headers: [Header];
  status: uint16;
}

table RequestBody {
  req_id: [ubyte];
  length: uint32;
}

table ResponseBody {
  req_id: [ubyte];
  length: uint32;
}

table EndExchange {
  req_id: [ubyte];
  client_start: long;
  client_end: long;
  status: uint16;
  // CRC32C of each journaled body, as an unsigned 32-bit value widened to int64, or -1
  // when the writer did not compute one. The width is what makes -1 mean that: every
  // 32-bit value is a legitimate CRC32C of some input, 0xFFFFFFFF included, so a uint32
  // field has no room left to say "absent". FlatBuffers omits a field equal to its
  // default, so "not recorded" — the common case, since most exchanges carry no request
  // body — costs nothing on disk.
  request_crc32c: long = -1;
  response_crc32c: long = -1;
  proxy_start: int64;
  proxy_first_byte_received: int64;
  proxy_end: int64;
  request_header_bytes: long;
  request_body_bytes: long;
  response_header_bytes: long;
  response_body_bytes: long;
  attributes: [Header];
}

union EventPayload {
  ClientRequest,
  UpstreamRequest,
  RequestBody,
  ResponseBody,
  UpstreamResponse,
  ClientResponse,
  EndExchange
}

table JournalEvent {
  event: EventPayload;
}

root_type JournalEvent;