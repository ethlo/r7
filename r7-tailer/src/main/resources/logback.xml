<configuration>
    <!--
      The tailer's stdout is the JSON lines data stream when json.output is stdout (it writes
      records there for a container's log driver / Promtail / Fluent Bit to tail). Logging must
      never share stdout with that stream, or log lines interleave with JSON records and the
      result is not valid JSONL. All logging goes to stderr instead; stdout stays data-only.
    -->
    <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.err</target>
        <encoder>
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX, UTC} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="STDERR"/>
    </root>
</configuration>
